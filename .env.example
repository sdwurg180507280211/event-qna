DATABASE_URL="postgresql://event_qna:event_qna@localhost:5432/event_qna?schema=public"

# Use long random values in production.
SESSION_SECRET="replace-with-at-least-32-random-characters"
STREAM_SSO_SECRET="replace-with-a-different-long-random-secret"
ADMIN_PASSWORD="change-me"

# Livestream tickets use issuer/audience verification.
STREAM_TICKET_ISSUER="livestream"
STREAM_TICKET_AUDIENCE="event-qna"

# If true, livestream-ticket users must also exist in the event whitelist.
STREAM_REQUIRE_WHITELIST="false"

# Keep true for HTTPS; false is only for temporary HTTP acceptance.
COOKIE_SECURE="true"
