# Copy to .env.production; supply separate random values before starting.
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
DATABASE_URL=postgresql://event_qna:REPLACE_DATABASE_PASSWORD@postgres:5432/event_qna?schema=public
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
STREAM_SSO_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_STREAM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
STREAM_TICKET_ISSUER=livestream
STREAM_TICKET_AUDIENCE=event-qna
STREAM_REQUIRE_WHITELIST=false
COOKIE_SECURE=true
APP_BIND=127.0.0.1
APP_PORT=3036
